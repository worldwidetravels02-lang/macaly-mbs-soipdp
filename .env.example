# Browser-safe Supabase project URL and publishable/anon key only.
# Never put a Supabase service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Set this to the final public website origin after purchasing/connecting a domain.
VITE_CANONICAL_ORIGIN=https://your-domain.example
